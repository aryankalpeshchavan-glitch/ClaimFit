# All optional. Without ANTHROPIC_API_KEY the app runs on the labeled rule-based extractor.
ANTHROPIC_API_KEY=
SCOPELOCK_MODEL=claude-sonnet-5-5
SCOPELOCK_LLM_TIMEOUT=20
SCOPELOCK_DB=scopelock.db
SCOPELOCK_RATE_LIMIT_PER_MIN=40
# SCOPELOCK_DISABLE_LLM=1
# SCOPELOCK_LOG_LEVEL=INFO
# SCOPELOCK_WEB_DIR=app/web   # where the built frontend is served from
# Set SCOPELOCK_RATE_LIMIT_PER_MIN=0 only for local browser tests.
